# Groq API key (Required for fast LLM inference & chat)
# Get a free Groq API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Google Gemini API key (Vision & multimodal analysis)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Read-only mailbox check (IMAP app password, not login password)
JARVIS_EMAIL_USER=
JARVIS_EMAIL_PASSWORD=
JARVIS_EMAIL_HOST=
JARVIS_EMAIL_PORT=

# Optional: where follow-ups & persistent memory are saved (default: ~/.jarvis)
# JARVIS_HOME=

# Optional: Meta WhatsApp Cloud API credentials
# JARVIS_WA_TOKEN=
# JARVIS_WA_PHONE_ID=
# JARVIS_WA_WABA_ID=
# JARVIS_WA_APP_SECRET=
# JARVIS_WA_VERIFY_TOKEN=jarvis-whatsapp
# JARVIS_WA_API_VERSION=v25.0
# Public HTTPS address the WhatsApp webhook is reachable on
# JARVIS_PUBLIC_URL=
